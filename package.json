{
  "name": "drps-ci-cd-qa-automation",
  "version": "1.2.0",
  "private": true,
  "description": "Playwright checkout and renewal QA suite for Quick Heal QA OCI staging",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:checkout": "playwright test tests/checkout",
    "test:renewal": "playwright test tests/renewal",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "dotenv": "16.4.7"
  }
}